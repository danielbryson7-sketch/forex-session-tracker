# Copy to slack-credentials.local.ps1 (ignored by Git) and chmod 600.
# Threaded alerts with entry charts: install the Slack app with chat:write and
# files:write, invite it to the destination channel, then use its Bot User OAuth
# Token and channel ID. The OANDA read-only candle fetch uses the V2 credentials.
$script:slackBotToken = 'xoxb-REPLACE-WITH-BOT-TOKEN'
$script:slackChannelId = 'C0123456789'
# Optional legacy fallback for flat messages when the bot settings are absent:
# $script:slackWebhookUrl = 'https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK'
